# SHADOWPRINT Environment Variables
# Copy this file to .env and fill in your values

# n8n Webhook URL (from your n8n workflow)
VITE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/shadowprint-scan

# Secret key for API authentication (generate with: openssl rand -hex 32)
VITE_SECRET_KEY=your-secret-key-here

# HaveIBeenPwned API Key (get from https://haveibeenpwned.com/API/Key)
# Note: This goes in n8n credentials, NOT in the frontend
HIBP_API_KEY=your-hibp-api-key
